# Copy to .env.local and fill in. .env.local is git-ignored: never commit keys.

# Every AI call goes through Mubit (hackathon rule).
MUBIT_API_KEY=
MUBIT_ANTHROPIC_URL=https://api.mubit.ai/anthropic
# Starter credit covers claude-opus-5-5, claude-sonnet-5-5, claude-haiku-4-5 on this route.
ANALYST_MODEL=

PORT=4321
# Optional: a dedicated Polygon RPC (Alchemy/QuickNode) instead of the free public node.
POLYGON_RPC=
# Cheap yes/no gate before the analyst (leave empty to send every matched post to the analyst).
GATE_MODEL=
